{
  "name": "@gilabs/visio-schema",
  "version": "0.9.1",
  "description": "The Visio wire contract for TypeScript: generated protobuf bindings plus the drivers and codecs that ride on them.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./wire/ota": {
      "types": "./dist/wire/ota.d.ts",
      "default": "./dist/wire/ota.js"
    },
    "./gen/*": {
      "types": "./dist/gen/*.d.ts",
      "default": "./dist/gen/*.js"
    },
    "./golden/*": "./golden/*"
  },
  "files": [
    "dist",
    "golden",
    "README.md"
  ],
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.12.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.47.2",
    "@bufbuild/protobuf": "2.12.0",
    "@bufbuild/protoc-gen-es": "2.12.0",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "gen": "buf generate .. --template buf.gen.es.yaml",
    "build": "tsc -p tsconfig.build.json",
    "pack-check": "npm run build && node scripts/stage-golden.mjs && node scripts/verify-pack.mjs",
    "prepack": "npm run pack-check",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "publishConfig": {
    "access": "public"
  }
}
